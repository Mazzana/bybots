{
  "name": "byfinity-bots",
  "version": "0.3.1-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Open-source Web and desktop workspace for building, running, and supervising Hermes AI Bots.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mazzana/bybots.git"
  },
  "homepage": "https://github.com/Mazzana/bybots#readme",
  "bugs": {
    "url": "https://github.com/Mazzana/bybots/issues"
  },
  "keywords": [
    "hermes",
    "agents",
    "bots",
    "electron",
    "react"
  ],
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10"
  },
  "author": {
    "name": "Byfinity"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-stack.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "dev:desktop": "node scripts/dev-stack.mjs --desktop",
    "test": "node scripts/check-version.mjs && node scripts/check-public-docs.mjs && vitest run",
    "test:docs": "node scripts/check-public-docs.mjs",
    "test:version": "node scripts/check-version.mjs",
    "test:e2e": "playwright test",
    "test:production-start": "node scripts/check-production-start.mjs",
    "test:windows-package-smoke": "node scripts/check-packaged-app.mjs",
    "test:windows-artifacts": "node scripts/check-windows-artifacts.mjs",
    "test:windows-artifacts:signed": "node scripts/check-windows-artifacts.mjs --require-signed",
    "test:macos-package-smoke": "node scripts/check-packaged-app.mjs",
    "test:macos-artifacts": "node scripts/check-macos-artifacts.mjs",
    "test:macos-artifacts:signed": "node scripts/check-macos-artifacts.mjs --require-signed",
    "test:hermes": "tsx scripts/check-hermes-contract.ts",
    "test:hermes:health": "tsx scripts/check-hermes-contract.ts --health-only",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/check-version.mjs && tsc --noEmit && vite build && node scripts/check-bundle-budget.mjs && npm run build:server && npm run build:electron",
    "build:server": "node scripts/build-server.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "screenshots": "node scripts/capture-public-screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package:win": "npm run build && electron-builder --win nsis portable --publish never",
    "package:win:dir": "npm run build && electron-builder --win dir",
    "package:mac": "npm run build && electron-builder --mac dmg zip --universal --publish never",
    "package:mac:dir": "npm run build && electron-builder --mac dir --universal",
    "start": "node dist-server/index.js",
    "start:local": "npm run build && node scripts/dev-stack.mjs --production",
    "start:server": "tsx server/index.ts"
  },
  "build": {
    "appId": "com.byfinity.bots",
    "productName": "ByBots",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "mac": {
      "icon": "build/icon-1024.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        { "x": 140, "y": 220, "type": "file" },
        { "x": 400, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ByBots",
      "uninstallDisplayName": "ByBots"
    }
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "blobatar": "^2.7.0",
    "fastify": "^5.6.2",
    "lucide-react": "^1.38.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  }
}
