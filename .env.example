# Non-secret local settings
BYFINITY_HOST=127.0.0.1
BYFINITY_PORT=4179
HERMES_URL=http://127.0.0.1:9120

# Optional comma-separated public hostnames accepted only when an authenticated
# reverse proxy forwards to a tokenless loopback Bridge.
# BYFINITY_TRUSTED_HOSTNAMES=bybots.example.ts.net

# Optional directory visible at the same absolute path to both the Bridge and
# Hermes. Required for profile import/export when they run in separate containers.
# BYFINITY_HERMES_EXCHANGE_DIR=

# Secret Hermes session token required for chat and gateway switching.
# Never commit a real value.
HERMES_DASHBOARD_SESSION_TOKEN=

# Optional user-scoped path for persisted gateway selection.
# BYFINITY_CONFIG_FILE=

# Optional compatibility alias for an administrator Bridge token.
# Prefer the role-specific variables below for new deployments.
BYFINITY_REMOTE_TOKEN=

# Optional role-specific Bridge tokens. Generate independent random values and
# inject them through the deployment secret store; never commit real values.
# BYFINITY_ADMIN_TOKEN=
# BYFINITY_OPERATOR_TOKEN=
# BYFINITY_VIEWER_TOKEN=
