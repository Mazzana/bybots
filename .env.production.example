# Copy to .env.production on the deployment host and protect it with mode 600.
# Never commit the real value.
HERMES_DASHBOARD_SESSION_TOKEN=

# Optional exact hostname exposed by an authenticated private reverse proxy.
# BYFINITY_TRUSTED_HOSTNAMES=bybots.example.ts.net

# Optional role-specific Bridge tokens for multi-user deployments. Generate
# independent random values in the deployment secret store.
# BYFINITY_ADMIN_TOKEN=
# BYFINITY_OPERATOR_TOKEN=
# BYFINITY_VIEWER_TOKEN=
